---
const items = [
  { name: "About", href: "/about/" },
  { name: "Research", href: "/research/" },
  { name: "People", href: "/people/" },
  { name: "Projects", href: "/project/" },
  { name: "Publications", href: "/publications/" },
  { name: "Opportunities", href: "/opportunities/" },
  { name: "CV", href: "/cv/" },
  { name: "Contact", href: "/contact/" },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---

<header class="sticky top-0 z-40 bg-sky-900 text-white shadow-md">
  <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4">
    <a href="/" class="flex min-w-0 items-center gap-3 shrink-0">
      <span class="font-serif text-lg font-semibold text-white">Nick McKay</span>
    </a>

    <!-- Desktop menu -->
    <ul class="hidden md:flex items-center gap-0.5 text-sm font-medium">
      {
        items.map((i) => (
          <li>
            <a href={i.href} class:list={["nav-link", isActive(i.href) && "nav-active"]}>
              {i.name}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile toggle -->
    <button id="menu-toggle" class="md:hidden p-2" aria-label="Open menu" aria-expanded="false">
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-sky-700 bg-sky-900 px-4 pb-4 text-sm">
    <a href="/" class="mobile-link">Home</a>
    {items.map((i) => <a href={i.href} class="mobile-link">{i.name}</a>)}
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>

<style>
  @reference "../styles/global.css";
  .nav-link {
    @apply flex items-center whitespace-nowrap rounded-md px-3 py-2 text-sky-100 transition-colors hover:bg-sky-800 hover:text-white;
  }
  .nav-active {
    @apply bg-sky-800 text-clay-300;
  }
  .mobile-link {
    @apply block py-2 text-sky-100 hover:text-white;
  }
</style>
