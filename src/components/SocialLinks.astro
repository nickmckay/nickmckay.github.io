---

<ul class:list={["flex items-center gap-4", klass]}>
  {
    links.map((l) => (
      <li>
        <a href={l.href} aria-label={l.name} title={l.name} class="opacity-80 transition-opacity hover:opacity-100">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
            <path d={icons[l.name]} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
