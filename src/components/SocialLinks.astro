---
/** Inline SVG icon links: GitHub, ORCID, Google Scholar, X, email. */
interface Props {
  class?: string;
}
const { class: klass = "" } = Astro.props;

const links = [
  { name: "GitHub", href: "https://github.com/nickmckay" },
  { name: "ORCID", href: "https://orcid.org/0000-0003-3598-5113" },
