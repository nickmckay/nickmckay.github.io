  ORCID:
    "M12 .5C5.65.5.5 5.65.5 12S5.65 23.5 12 23.5 23.5 18.35 23.5 12 18.35.5 12 .5ZM7.9 17.5H6.1V9.1h1.8v8.4Zm-.9-9.6a1.13 1.13 0 1 1 0-2.26 1.13 1.13 0 0 1 0 2.26Zm10.1 9.6h-4.8V9.1h4.5c2.9 0 4.5 1.9 4.5 4.2 0 2.4-1.8 4.2-4.2 4.2Zm-.3-6.8h-2.7v5.2h2.7c1.6 0 2.7-1.1 2.7-2.6 0-1.5-1.1-2.6-2.7-2.6Z",
