---
import Base from "../layouts/Base.astro";
import AnnouncementBanner from "../components/AnnouncementBanner.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { getPublications } from "../lib/publications";

const latest = getPublications().slice(0, 3);
---

<Base title="Home">
  <AnnouncementBanner />
  <div class="mx-auto grid max-w-5xl items-center gap-10 px-4 py-14 md:grid-cols-2 md:py-20">
    <img
      src="/img/revoir.jpg"
      alt="Nick McKay overlooking a mountain landscape"
      class="w-full rounded-2xl object-cover shadow-md"
      width="1200"
      height="800"
    />
    <div>
      <h1 class="font-serif text-4xl font-bold text-sky-900 sm:text-5xl">Nick McKay</h1>
      <p class="mt-3 font-serif text-xl text-clay-600">Using the past to understand our climate future</p>
      <p class="mt-5 leading-relaxed text-slate-700">
        I use natural records of past climate variability to inform our understanding of climate
        dynamics. My research spans from the tropics to the Arctic, on timescales ranging from years
        to millennia and on spatial scales ranging from hemispheres to meters. Through my work
        directing the Paleoclimate Dynamics Laboratory at Northern Arizona University, I help
        prepare for and adapt to future climate changes by better understanding the complex details
        of our climate and earth systems.
      </p>
      <div class="mt-6 flex items-center gap-6">
        <a
          href="/about/"
          class="rounded-lg bg-sky-800 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-sky-700"
        >
          Learn More →
        </a>
        <SocialLinks class="text-sky-800" />
      </div>
    </div>
  </div>

  <div class="border-t border-slate-100 bg-sky-50/50">
    <div class="mx-auto max-w-5xl px-4 py-10">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="font-serif text-xl font-semibold text-sky-900">Latest publications</h2>
        <a href="/publications/" class="text-sm font-medium text-sky-700 hover:underline">
          All {getPublications().length} publications →
        </a>
      </div>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        {
          latest.map((p) => (
            <a
              href={
                p.doi
                  ? `https://doi.org/${p.doi}`
                  : `https://scholar.google.com/citations?view_op=view_citation&user=j8_CgoEAAAAJ&citation_for_view=j8_CgoEAAAAJ:${p.pubid}`
              }
              class="group rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition-shadow hover:shadow-md"
            >
              <p class="text-xs font-semibold uppercase tracking-wide text-clay-700">{p.year}</p>
              <p class="mt-1 text-sm font-medium leading-snug text-slate-900 group-hover:text-sky-700">
                {p.title}
              </p>
              <p class="mt-1.5 text-xs italic text-slate-500">{p.journal}</p>
            </a>
          ))
        }
      </div>
      <p class="mt-3 text-xs text-slate-400">Updated weekly from Google Scholar.</p>
    </div>
  </div>
</Base>
